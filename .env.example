# Copie este arquivo pra .env e preencha com valores reais.
# .env nunca é commitado (está no .gitignore): cada pessoa usa o próprio.

# Qual fonte usar nesta execução: precisa ter uma seção [FONTE] correspondente
# em fontes.ini (copie fontes.ini.example pra fontes.ini e preencha as suas
# fontes lá; esse arquivo também não é commitado). Pode ser sobrescrita na
# linha de comando (ex.: FONTE=mysql .venv/bin/python persistir_datamart_duckdb.py),
# sem precisar editar nenhum arquivo.
FONTE=trino_bigdata

# TABLES não precisa estar declarado aqui: cada fonte já tem seu próprio
# campo "tables" na seção correspondente em fontes.ini (bases diferentes
# costumam ter tabelas diferentes). Pra sobrescrever pontualmente, numa
# execução avulsa, sem mexer em arquivo nenhum, passe TABLES direto na linha
# de comando, por exemplo:
#   FONTE=mysql TABLES=tabela1,tabela2 .venv/bin/python persistir_datamart_duckdb.py
#
# MODO "BASE INTEIRA": passe TABLES=TODAS (case-insensitive; também pode ser
# passado via argv, ex. `.venv/bin/python persistir_datamart_duckdb.py TODAS`)
# pra perfilar TODAS as tabelas do schema/diretório configurado na seção da
# FONTE em uso (fontes.ini), em vez de listar uma por uma. Esse também é o
# comportamento padrão quando a fonte em uso não tem "tables" preenchido em
# fontes.ini (exceto TIPO=parquet, que deriva o nome da tabela do próprio
# path). Nesse modo a lista de tabelas é DESCOBERTA em tempo de execução (ver
# src/extraction/table_discovery.py):
#   - Postgres/MySQL/SQL Server: information_schema.tables do schema
#     configurado: testado empiricamente que funciona igual nos três.
#   - Oracle: ALL_TABLES do owner (o valor do campo `schema` é colocado em
#     MAIÚSCULO automaticamente antes de comparar com o catálogo Oracle,
#     não precisa escrever em maiúsculo em fontes.ini).
#   - Trino: information_schema.tables do schema: por ANALOGIA ao padrão
#     ANSI que funcionou nos três bancos acima; NÃO validado ponta a ponta
#     contra um Trino real (sem rede pro BigDataPE nesta sandbox).
#   - Parquet: enumera arquivos .parquet diretamente dentro do DIRETÓRIO
#     configurado no campo `path` (NÃO desce em subpastas: isso evitaria
#     ambiguidade com o caso de particionamento Hive, onde vários arquivos
#     formam UMA tabela só, não tabelas distintas); cada arquivo .parquet
#     vira uma tabela (nome = nome do arquivo sem extensão).
# Uma tabela falhando (permissão, tipo exótico, tabela vazia/sem colunas
# etc.) não interrompe as demais: fica registrada num resumo ao final da
# execução (tabelas OK vs. FALHA), e o processo sai com código 1 se alguma
# tabela falhou (mesmo com as outras tendo sido persistidas com sucesso).

# --- Tetos de custo computacional do DuckDBProfiler (opcional) ---
# Não precisa descomentar nada aqui: cada variável já tem um padrão testado
# neste trabalho (valor entre parênteses). Só existem pra permitir ajustar o
# custo em infraestrutura diferente da usada nos testes, sem alterar código
# nem gerar uma nova versão da ferramenta. Limiares que definem SEMÂNTICA (o
# que conta como Identifier, Categorical etc.) não entram aqui: são sobre o
# que a métrica SIGNIFICA, não sobre custo, e continuam fixos no código.
# DQP_TETO_COLUNAS_CORRELACAO=60        # colunas elegíveis p/ matriz de correlação (e, por tabela, p/ a busca de dependência funcional)
# DQP_TETO_CARDINALIDADE_CRAMERS_V=200  # valores distintos máximos p/ entrar na matriz de Cramér's V
# DQP_TETO_COLUNAS_DUPLICATAS=40        # colunas máximas p/ checar linhas duplicadas
# DQP_LIMIAR_CRAMERS_V_FD=0.6           # Cramér's V mínimo p/ um par virar candidato a dependência funcional
# DQP_TETO_SELETIVIDADE_ORIGEM_FD=0.5   # seletividade máxima da coluna de origem p/ ainda valer testar FD
# DQP_TETO_PARES_TESTADOS_FD=20         # teto fixo final de pares testados p/ dependência funcional

# --- Postgres LOCAL do data mart do dqp (onde os perfilamentos são persistidos) ---
# Sempre o DESTINO dos resultados: nunca a fonte extraída (essa mora em
# fontes.ini, não aqui). Nunca aponte os dois pro mesmo uso, mesmo que, por
# coincidência, seja fisicamente o mesmo servidor Postgres.
PG_DATAMART_HOST=localhost
PG_DATAMART_PORT=5432
PG_DATAMART_DATABASE=dqp_datamart
PG_DATAMART_USER=dqp_user
PG_DATAMART_PASSWORD=
